<Window x:Class="SmartRamOptimizer.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart RAM Optimizer"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="22">
        <Border Style="{StaticResource WindowSurfaceStyle}" />

        <StackPanel Margin="25,24,25,22">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;"
                           FontFamily="{StaticResource IconFont}"
                           Foreground="{StaticResource AmberBrush}"
                           FontSize="18"
                           Margin="0,2,10,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HeadingText"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           MaxWidth="300" />
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       Margin="0,14,0,0"
                       Foreground="{StaticResource SubtleBrush}"
                       FontSize="13"
                       LineHeight="19"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ConfirmMessage" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource PillButtonStyle}"
                        Height="34"
                        AutomationProperties.AutomationId="ConfirmButton"
                        Click="ConfirmButton_Click" />
                <!-- The safe answer is the default: Enter and Escape both choose it. -->
                <Button x:Name="CancelButton"
                        Style="{StaticResource PillButtonStyle}"
                        Height="34"
                        Margin="8,0,0,0"
                        Background="{StaticResource AccentBrush}"
                        IsDefault="True"
                        IsCancel="True"
                        AutomationProperties.AutomationId="CancelButton" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
