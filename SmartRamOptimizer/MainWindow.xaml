<Window x:Class="SmartRamOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart RAM Optimizer"
        Width="460"
        Height="636"
        MinWidth="460"
        MinHeight="636"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="RoundCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#AAB4CD" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Circle"
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            BorderThickness="2"
                            BorderBrush="#5865F2"
                            Background="#1B2231">
                                <Ellipse x:Name="Dot"
                                 Width="8"
                                 Height="8"
                                 Fill="#36CE7D"
                                 Opacity="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#36CE7D" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#202738" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ChromeButtonSurface"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonSurface" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonSurface" Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Border CornerRadius="30"
                BorderThickness="1"
                BorderBrush="#2A3448">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#121620" Offset="0" />
                    <GradientStop Color="#181D2A" Offset="0.55" />
                    <GradientStop Color="#10131B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.42"
                                  Color="#05070C" />
            </Border.Effect>
        </Border>

        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,8,18,0">
                <TextBlock Text="Smart RAM Optimizer"
                           VerticalAlignment="Center"
                           Foreground="#AAB4CD"
                           FontSize="13"
                           FontWeight="SemiBold" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Click="MinimizeButton_Click"
                            Background="#202738">
                        <Path Data="M0,0 L12,0"
                               Stroke="#AAB4CD"
                               StrokeThickness="2"
                               StrokeStartLineCap="Round"
                               StrokeEndLineCap="Round" />
                    </Button>

                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Margin="8,0,0,0"
                            Click="CloseButton_Click"
                            Background="#2A2130">
                        <Path Data="M0,0 L9,9 M9,0 L0,9"
                               Stroke="#FF8F9B"
                               StrokeThickness="2"
                               StrokeStartLineCap="Round"
                               StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="24,8,24,30"
                        HorizontalAlignment="Center">
                <Grid Width="106"
                      Height="106"
                      Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/Assets/app_icon.png"
                           Width="96"
                           Height="96"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="Smart RAM Optimizer"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Text="Limiter Disabled"
                           Margin="0,7,0,24"
                           Foreground="#FF8F9B"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <Button x:Name="LimiterToggleButton"
                        Width="214"
                        Height="74"
                        Click="LimiterToggleButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        FocusVisualStyle="{x:Null}"
                        OverridesDefaultStyle="True">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Button.Template>

                    <Grid Width="214" Height="74">
                        <Border x:Name="ToggleGlow"
                                Margin="7"
                                CornerRadius="37"
                                Background="#36CE7D">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ToggleGlowEffect"
                                                  BlurRadius="24"
                                                  ShadowDepth="0"
                                                  Opacity="0"
                                                  Color="#36CE7D" />
                            </Border.Effect>
                        </Border>

                        <Border x:Name="ToggleTrack"
                                CornerRadius="37"
                                BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="ToggleTrackBorderBrush" Color="#463743" />
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush x:Name="ToggleTrackBrush" Color="#9B424C" />
                            </Border.Background>
                        </Border>

                        <Border x:Name="ToggleThumb"
                                Width="64"
                                Height="64"
                                Margin="5"
                                HorizontalAlignment="Left"
                                CornerRadius="32"
                                Background="#F7F9FF">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ToggleThumbTransform" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="2"
                                                  Opacity="0.28"
                                                  Color="#000000" />
                            </Border.Effect>
                            <TextBlock x:Name="ToggleThumbLabel"
                                       Text="OFF"
                                       Foreground="#D84A57"
                                       FontSize="16"
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <Grid Margin="0,20,0,0" Width="350">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Discord Card -->
                    <Border Grid.Column="0"
                            CornerRadius="16"
                            Background="#1B2231"
                            BorderBrush="#5865F2"
                            BorderThickness="1"
                            Padding="12,14">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/Discord/discord_logo.png" Width="28" Height="28" Margin="0,0,0,6" />
                            <TextBlock Text="DISCORD"
                                       Foreground="#5865F2"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="DiscordRamText"
                                       Text="0 MB"
                                       Margin="0,4,0,0"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="DiscordProcessCountText"
                                       Text="0 processes"
                                       Margin="0,2,0,0"
                                       Foreground="#8C98B3"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Brave Card -->
                    <Border Grid.Column="2"
                            CornerRadius="16"
                            Background="#1B2231"
                            BorderBrush="#FF5000"
                            BorderThickness="1"
                            Padding="12,14">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/Brave/brave_logo_clean.png" Width="28" Height="28" Margin="0,0,0,6" />
                            <TextBlock Text="BRAVE"
                                       Foreground="#FF5000"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="BraveRamText"
                                       Text="0 MB"
                                       Margin="0,4,0,0"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="BraveProcessCountText"
                                       Text="0 processes"
                                       Margin="0,2,0,0"
                                       Foreground="#8C98B3"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="TotalRamText"
                           Text="Total RAM: 0 MB"
                           Margin="0,10,0,0"
                           Foreground="#8C98B3"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <CheckBox x:Name="AutoStartCheckBox"
                          Content="Launch with Windows in tray"
                          Margin="0,16,0,0"
                          Click="AutoStartCheckBox_Click"
                          Style="{StaticResource RoundCheckBoxStyle}"
                          HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
