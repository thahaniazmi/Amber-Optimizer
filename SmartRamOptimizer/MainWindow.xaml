<Window x:Class="SmartRamOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart RAM Optimizer"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- One application: icon, name, live usage, what is freed, remove button, on/off switch. -->
        <DataTemplate x:Key="AppRowTemplate">
            <Border x:Name="Row"
                    Padding="0,11"
                    Background="Transparent"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="IconHost"
                          Width="36"
                          Height="36">
                        <Border x:Name="Avatar"
                                CornerRadius="10"
                                Background="{StaticResource ControlBrush}">
                            <TextBlock Text="{Binding Initial}"
                                       Foreground="{StaticResource SubtleBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Icon}"
                               Width="32"
                               Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel x:Name="Freed"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                ToolTip="Memory this app held before it was trimmed and has not taken back.">
                        <TextBlock Text="{Binding FreedText}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="freed"
                                   HorizontalAlignment="Right"
                                   Margin="0,1,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                    </StackPanel>

                    <Button x:Name="RemoveButton"
                            Grid.Column="3"
                            Margin="2,0,0,0"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE74D;"
                            Opacity="0"
                            IsHitTestVisible="False"
                            ToolTip="Remove from the list"
                            AutomationProperties.Name="{Binding RemoveLabel}"
                            Click="RemoveAppButton_Click" />

                    <CheckBox Grid.Column="4"
                              Margin="6,0,0,0"
                              Style="{StaticResource SwitchStyle}"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding ToggleLabel}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                    <Setter TargetName="IconHost" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFreed}" Value="True">
                    <Setter TargetName="Freed" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- The remove button stays in the tree (keyboard and screen readers can reach it)
                     but only shows, and only takes clicks, once the row is pointed at or focused. -->
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                    <Setter TargetName="RemoveButton" Property="IsHitTestVisible" Value="True" />
                </Trigger>
                <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                    <Setter TargetName="RemoveButton" Property="IsHitTestVisible" Value="True" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StatusTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusState}" Value="Active">
                    <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Paused">
                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Amber once memory is getting full, red when it is nearly gone. -->
        <Style x:Key="SystemMemoryBarStyle"
               TargetType="{x:Type ProgressBar}"
               BasedOn="{StaticResource MemoryBarStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMemoryLevel}" Value="High">
                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SystemMemoryLevel}" Value="Critical">
                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stays closed-on-click: while the menu is open the button ignores the click that dismisses it. -->
        <Style x:Key="SettingsButtonStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource ChromeButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen, ElementName=SettingsPopup}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Border Style="{StaticResource WindowSurfaceStyle}" />

        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="20,8,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app_icon.png"
                           Width="20"
                           Height="20"
                           Margin="0,0,9,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Smart RAM Optimizer"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleBrush}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="SettingsButton"
                                  Style="{StaticResource SettingsButtonStyle}"
                                  Content="&#xE713;"
                                  FontSize="14"
                                  ToolTip="Settings"
                                  AutomationProperties.Name="Settings"
                                  AutomationProperties.AutomationId="SettingsButton" />
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Margin="8,0,0,0"
                            Content="&#xE921;"
                            FontSize="10"
                            ToolTip="Minimize to tray"
                            AutomationProperties.Name="Minimize to tray"
                            Click="HideButton_Click" />
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Margin="8,0,0,0"
                            Background="#2A2130"
                            Foreground="{StaticResource RedBrush}"
                            Content="&#xE8BB;"
                            FontSize="10"
                            ToolTip="Close to tray"
                            AutomationProperties.Name="Close to tray"
                            Click="HideButton_Click" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,10,22,24">
                <Grid Margin="2,0,2,10">
                    <TextBlock Text="Applications"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource StatusTextStyle}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,3"
                               FontSize="12"
                               FontWeight="SemiBold"
                               AutomationProperties.AutomationId="StatusText" />
                </Grid>

                <Border Background="{StaticResource InsetBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,3,10,3">
                    <Grid>
                        <ScrollViewer MaxHeight="300"
                                      Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Apps}"
                                          ItemTemplate="{StaticResource AppRowTemplate}"
                                          Margin="0,0,4,0"
                                          Focusable="False" />
                        </ScrollViewer>
                        <TextBlock Text="No applications yet. Add one to start optimizing."
                                   Margin="0,16"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasApps}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- A short message with an optional action: "Removed Discord · Undo". -->
                <Border Margin="0,10,0,0"
                        Padding="14,7,6,7"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNoticeVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NoticeText}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="NoticeText" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Height="28"
                                Content="{Binding NoticeActionText}"
                                AutomationProperties.AutomationId="NoticeActionButton"
                                Click="NoticeActionButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PillButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoticeAction}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2"
                                Margin="2,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE711;"
                                FontSize="10"
                                ToolTip="Dismiss"
                                AutomationProperties.Name="Dismiss message"
                                Click="NoticeDismissButton_Click" />
                    </Grid>
                </Border>

                <Button Style="{StaticResource DashedButtonStyle}"
                        Margin="0,10,0,0"
                        AutomationProperties.Name="Add application"
                        AutomationProperties.AutomationId="AddAppButton"
                        Click="AddAppButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Margin="0,1,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Add application" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Stats -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            CornerRadius="14"
                            Padding="14,12"
                            ToolTip="Memory your optimized apps held before being trimmed and have not taken back.">
                        <StackPanel>
                            <TextBlock Text="Freed right now"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding FreedNowText}"
                                       Margin="0,3,0,0"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       AutomationProperties.AutomationId="FreedNowText" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBrush}"
                            CornerRadius="14"
                            Padding="14,12"
                            ToolTip="Everything trimmed since the optimizer started. The same memory can be counted more than once.">
                        <StackPanel>
                            <TextBlock Text="Freed this session"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding FreedSessionText}"
                                       Margin="0,3,0,0"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       AutomationProperties.AutomationId="FreedSessionText" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="2,16,2,6">
                    <TextBlock Text="System memory"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12" />
                    <TextBlock Text="{Binding SystemMemoryText}"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               AutomationProperties.AutomationId="SystemMemoryText" />
                </Grid>
                <ProgressBar Style="{StaticResource SystemMemoryBarStyle}"
                             Margin="2,0"
                             Value="{Binding SystemMemoryPercent, Mode=OneWay}"
                             AutomationProperties.Name="System memory in use" />

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,20,0,0"
                        IsEnabled="{Binding CanOptimizeNow}"
                        ToolTip="Trim every switched-on app right now, without waiting for it to sit in the background."
                        AutomationProperties.Name="{Binding OptimizeNowText}"
                        AutomationProperties.AutomationId="OptimizeNowButton"
                        Click="OptimizeNowButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Margin="0,1,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OptimizeNowText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="CoffeeButton"
                        Style="{StaticResource PillButtonStyle}"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        ToolTip="Support the people who make Smart RAM Optimizer"
                        AutomationProperties.Name="Buy us a coffee"
                        AutomationProperties.AutomationId="CoffeeButton"
                        Click="CoffeeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC32;"
                                   FontFamily="{StaticResource IconFont}"
                                   Foreground="{StaticResource CoffeeBrush}"
                                   FontSize="14"
                                   Margin="0,1,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Buy us a coffee" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Settings menu, opened by the gear button -->
        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom"
               HorizontalOffset="-226"
               VerticalOffset="8"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}">
            <Border Width="260"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#34405A"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,8,14,14">
                <StackPanel>
                    <Grid Margin="0,8">
                        <TextBlock Text="Optimize apps"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource SwitchStyle}"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding IsOptimizerEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="Optimize apps"
                                  AutomationProperties.AutomationId="OptimizerSwitch" />
                    </Grid>

                    <Grid Margin="0,8">
                        <StackPanel Margin="0,0,56,0">
                            <TextBlock Text="Aggressive mode"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Trim every 1.5 s, even the app you're using. Frees more, can stutter."
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource SwitchStyle}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  IsChecked="{Binding IsAggressiveMode, Mode=TwoWay}"
                                  AutomationProperties.Name="Aggressive mode"
                                  AutomationProperties.AutomationId="AggressiveSwitch" />
                    </Grid>

                    <Grid Margin="0,8">
                        <TextBlock Text="Launch with Windows"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource SwitchStyle}"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                  AutomationProperties.Name="Launch with Windows"
                                  AutomationProperties.AutomationId="StartupSwitch" />
                    </Grid>

                    <Button Style="{StaticResource PillButtonStyle}"
                            Margin="0,10,0,0"
                            Height="34"
                            Content="Quit Smart RAM Optimizer"
                            AutomationProperties.AutomationId="QuitButton"
                            Click="QuitButton_Click" />

                    <TextBlock Text="{Binding AboutText}"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               ToolTip="The optimizer's own memory, as Task Manager counts it."
                               AutomationProperties.AutomationId="AboutText" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
